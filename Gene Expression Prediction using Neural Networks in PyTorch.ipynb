      "outputs": [],
      "source": [
        "from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\n",
        "\"\"\"Evaluate the trained model by switch model to evaluation mode and display key regression metrics.\"\"\"\n",
        "from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score\n",
        "\n",
        "def evaluate_model(model, X_test, y_test):\n",
        "    model.eval() # Switch model to evaluation mode\n",
        "    with torch.no_grad():\n",
        "        preds = model(X_test).numpy().flatten()\n",
        "\n",
        "    actual = y_test.numpy().flatten()\n",
        "\n",
        "    mse = mean_squared_error(actual, preds) # Calculate evaluation metrics\n",
        "    rmse = np.sqrt(mse)\n",
        "    mae = mean_absolute_error(actual, preds)\n",
        "    r2 = r2_score(actual, preds)\n",
        "\n",
        "    print(f\"  MSE:  {mse:.4f}\")  # Print results in a readable format\n",
        "    print(f\"  RMSE: {rmse:.4f}\")\n",
        "    print(f\"  MAE:  {mae:.4f}\")\n",
        "    print(f\"  R²:   {r2:.4f}\")\n",
        "    return { # Return results for further use\n",
        "        'MSE': mse,\n",
        "        'RMSE': rmse,\n",
        "        'MAE': mae,\n",
        "        'R2': r2,\n",
        "        'preds': preds,\n",
        "        'actual': actual\n",
        "    }"
      ]
    },
