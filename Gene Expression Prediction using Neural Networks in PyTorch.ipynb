        "def plot_predictions(results, title):\n",
        "\n",
        "    plt.figure(figsize=(5, 5)) # Create a square plot for better visual comparison\n",
        "\n",
        "    plt.scatter(results['actual'],results['preds'],alpha=0.5, color='steelblue',  s=20) # Scatter plot of actual vs predicted values\n",
        "\n",
        "    mn = min(results['actual'].min(), results['preds'].min())   # Determine the range for the reference line\n",
        "    mx = max(results['actual'].max(), results['preds'].max())\n",
        "\n",
        "    plt.plot([mn, mx], [mn, mx], 'r--', linewidth=1, label='Perfect prediction') # Plot a diagonal line representing perfect predictions\n",
        "    plt.xlabel('Actual lacZ')\n",
        "    plt.ylabel('Predicted lacZ')\n",
        "    plt.title(f'Predicted vs Actual — {title}')\n",
        "    plt.legend()\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(f'pred_{title.replace(\" \", \"_\")}.png', dpi=150, bbox_inches='tight')\n",
        "    plt.show()"
      ]
