        "    plt.ylabel('MSE Loss')\n",
        "    plt.legend()\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(f'loss_{title.replace(\" \", \"_\")}.png', dpi=150, bbox_inches='tight')\n",
