        "for epoch in range(ITER3_EPOCHS):\n",
        "    model3.train()\n",
        "    batch_losses = []\n",
        "    for X_batch, y_batch in train_loader3:\n",
        "        optimizer3.zero_grad()\n",
        "        loss = criterion(model3(X_batch), y_batch)\n",
        "        loss.backward()\n",
        "        optimizer3.step()\n",
        "        batch_losses.append(loss.item())\n",
        "    train_loss3.append(np.mean(batch_losses))\n",
        "\n",
        "    model3.eval()\n",
        "    with torch.no_grad():\n",
        "        v_losses = [criterion(model3(xb), yb).item() for xb, yb in val_loader3]\n",
        "    val_loss3.append(np.mean(v_losses))\n",
        "\n",
        "    scheduler3.step(val_loss3[-1])\n",
        "\n",
        "    if (epoch + 1) % 30 == 0:\n",
        "        print(f'Epoch {epoch+1:3d}/{ITER3_EPOCHS} | Train: {train_loss3[-1]:.4f} | Val: {val_loss3[-1]:.4f}')\n",
        "\n"
      ]
